        "h": 8,
        "w": 6,
        "x": 12,
        "y": 41
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"grid_trading_bot\", trading_pair=\"$trading_pair\", trading_mode=\"$trading_mode\"} |= \"OrderManager\" |~ \"failed|ERROR|error\" [5m]))",
