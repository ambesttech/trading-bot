          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "row",
      "title": "C. Grid Strategy Insights",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 301,
      "title": "Active Grid Levels (Approx)",
      "type": "stat",
      "datasource": "Loki",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 26
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"grid_trading_bot\", trading_pair=\"$trading_pair\", trading_mode=\"$trading_mode\"} |= \"marked as pending at grid level\" [15m]))",
          "legendFormat": "Pending Levels"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 302,
      "title": "Profit per Grid Level (Proxy: Sell Fills by Grid)",
      "type": "timeseries",
      "datasource": "Loki",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 6,
        "y": 26
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (grid_level) (count_over_time({job=\"grid_trading_bot\", trading_pair=\"$trading_pair\", trading_mode=\"$trading_mode\"} |= \"OrderManager\" |= \"Sell order completed at grid level\" | regexp \"grid level (?P<grid_level>[\\\\d.]+)\" [5m]))",
          "legendFormat": "Grid {{grid_level}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "auto"
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 303,
      "title": "Buy/Sell Ratio",
      "type": "stat",
      "datasource": "Loki",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 26
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(count_over_time({job=\"grid_trading_bot\", trading_pair=\"$trading_pair\", trading_mode=\"$trading_mode\"} |= \"OrderManager\" |= \"Buy order completed at grid level\" [$__range])) + 0.0001) / (sum(count_over_time({job=\"grid_trading_bot\", trading_pair=\"$trading_pair\", trading_mode=\"$trading_mode\"} |= \"OrderManager\" |= \"Sell order completed at grid level\" [$__range])) + 0.0001)",
          "legendFormat": "Buy/Sell"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 304,
      "title": "Trade Distribution by Price (Fills by Grid)",
      "type": "timeseries",
      "datasource": "Loki",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (grid_level) (count_over_time({job=\"grid_trading_bot\", trading_pair=\"$trading_pair\", trading_mode=\"$trading_mode\"} |= \"OrderManager\" |~ \"Buy order completed at grid level|Sell order completed at grid level\" | regexp \"grid level (?P<grid_level>[\\\\d.]+)\" [10m]))",
          "legendFormat": "{{grid_level}}"
        }
