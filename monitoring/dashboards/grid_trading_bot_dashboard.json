{
  "title": "Grid Trading Bot Dashboard",
  "uid": "grid-trading-bot",
  "schemaVersion": 36,
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "trading_pair",
        "type": "query",
        "datasource": "Loki",
        "query": "label_values(trading_pair)",
        "refresh": 2,
        "includeAll": false,
        "current": {}
      },
      {
        "name": "trading_mode",
        "type": "query",
        "datasource": "Loki",
        "query": "label_values(trading_mode)",
        "refresh": 2,
        "includeAll": false,
        "current": {}
      },
      {
        "name": "strategy",
        "type": "query",
        "datasource": "Loki",
        "query": "label_values(strategy_type)",
        "refresh": 2,
        "includeAll": false,
        "current": {}
      },
      {
        "name": "candle_interval",
        "type": "custom",
        "label": "Candle Interval",
        "query": "15s,30s,1m,5m",
        "current": {
          "text": "1m",
          "value": "1m"
        },
        "options": [
          {
            "text": "15s",
            "value": "15s",
            "selected": false
          },
          {
            "text": "30s",
            "value": "30s",
            "selected": false
          },
          {
            "text": "1m",
            "value": "1m",
            "selected": true
          },
          {
            "text": "5m",
            "value": "5m",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "A. Key Performance Indicators (Stat Panels)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 101,
      "title": "Bot Status",
      "type": "stat",
      "datasource": "Loki",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"grid_trading_bot\", trading_pair=\"$trading_pair\", trading_mode=\"$trading_mode\"} |= \"current price\" [2m]))",
          "legendFormat": "Heartbeat"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": 0,
                "color": "red"
              },
              {
                "value": 1,
                "color": "green"
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 102,
      "title": "Real-Time PnL (Base Balance Delta)",
      "type": "stat",
      "datasource": "Loki",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "last_over_time({job=\"grid_trading_bot\", trading_pair=\"$trading_pair\", trading_mode=\"$trading_mode\"} |= \"BalanceTracker\" |= \"Total base balance\" | regexp \"Total base balance: (?P<v>[\\\\d.]+)\" | unwrap v [5m]) - first_over_time({job=\"grid_trading_bot\", trading_pair=\"$trading_pair\", trading_mode=\"$trading_mode\"} |= \"BalanceTracker\" |= \"Total base balance\" | regexp \"Total base balance: (?P<v>[\\\\d.]+)\" | unwrap v [5m])",
          "legendFormat": "PnL 5m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 103,
      "title": "Total Realized Profit (Proxy)",
      "type": "stat",
      "datasource": "Loki",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"grid_trading_bot\", trading_pair=\"$trading_pair\", trading_mode=\"$trading_mode\"} |= \"OrderManager\" |= \"Sell order completed at grid level\" [$__range]))",
          "legendFormat": "Sell Fills"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 104,
      "title": "Unrealized PnL (Proxy)",
      "type": "stat",
      "datasource": "Loki",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "last_over_time({job=\"grid_trading_bot\", trading_pair=\"$trading_pair\", trading_mode=\"$trading_mode\"} |= \"BalanceTracker\" |= \"Total base balance\" | regexp \"Total base balance: (?P<v>[\\\\d.]+)\" | unwrap v [$__auto])",
          "legendFormat": "Total Base"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value_and_name"
      }
    },
    {
      "type": "row",
      "title": "B. Trading Activity (Time Series Panels)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 201,
      "title": "Orders per Minute",
      "type": "timeseries",
      "datasource": "Loki",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"grid_trading_bot\", trading_pair=\"$trading_pair\", trading_mode=\"$trading_mode\"} |= \"OrderManager\" |= \"order completed at grid level\" [1m]))",
          "legendFormat": "Orders/min"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "auto"
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 202,
      "title": "Filled Buy vs Sell Orders",
      "type": "timeseries",
      "datasource": "Loki",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"grid_trading_bot\", trading_pair=\"$trading_pair\", trading_mode=\"$trading_mode\"} |= \"OrderManager\" |= \"Buy order completed at grid level\" [1m]))",
          "legendFormat": "Buy Fills/min"
        },
        {
          "refId": "B",
          "expr": "sum(count_over_time({job=\"grid_trading_bot\", trading_pair=\"$trading_pair\", trading_mode=\"$trading_mode\"} |= \"OrderManager\" |= \"Sell order completed at grid level\" [1m]))",
          "legendFormat": "Sell Fills/min"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "auto"
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 203,
      "title": "Cumulative PnL (Proxy: Total Base Balance)",
      "type": "timeseries",
      "datasource": "Loki",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "last_over_time({job=\"grid_trading_bot\", trading_pair=\"$trading_pair\", trading_mode=\"$trading_mode\"} |= \"BalanceTracker\" |= \"Total base balance\" | regexp \"Total base balance: (?P<v>[\\\\d.]+)\" | unwrap v [$__auto])",
          "legendFormat": "Total Base"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "auto"
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 204,
      "title": "Market Price vs Average Fill Price",
      "type": "timeseries",
      "datasource": "Loki",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "last_over_time({job=\"grid_trading_bot\", trading_pair=\"$trading_pair\", trading_mode=\"$trading_mode\"} |~ \"LiveExchangeService|BacktestExchangeService\" |= \"current price\" | regexp \"current price: (?P<price>[\\\\d.]+)\" | unwrap price [$__auto])",
          "legendFormat": "Market Price"
        },
        {
          "refId": "B",
          "expr": "avg_over_time({job=\"grid_trading_bot\", trading_pair=\"$trading_pair\", trading_mode=\"$trading_mode\"} |= \"OrderManager\" |~ \"Buy order completed at grid level|Sell order completed at grid level\" | regexp \"grid level (?P<price>[\\\\d.]+)\" | unwrap price [5m])",
          "legendFormat": "Avg Fill Price (5m)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "auto"
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 205,
      "title": "Inventory Over Time",
      "type": "timeseries",
      "datasource": "Loki",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "last_over_time({job=\"grid_trading_bot\", trading_pair=\"$trading_pair\", trading_mode=\"$trading_mode\"} |= \"BalanceTracker\" |= \"Crypto balance\" | regexp \"Crypto balance: (?P<crypto>[\\\\d.]+)\" | unwrap crypto [$__auto])",
          "legendFormat": "Crypto Inventory"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "auto"
          }
